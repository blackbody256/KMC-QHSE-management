# Copy to .env and change every value before this reaches anything but a laptop.
#
# The defaults in docker-compose.yml are development values, chosen so that a
# first run works without configuration. They are not safe, they are in source
# control, and they must never appear in a deployment. In production these come
# from a KMC-controlled secret store, not from a file.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=hwms
POSTGRES_PASSWORD=hwms-development-password

# --- Keycloak --------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-development-password

# Client secrets. These must match the values in
# deploy/keycloak/realm-hwms.json, or be changed in both places together.
GATEWAY_CLIENT_SECRET=development-only-gateway-secret-rotate-me
IDENTITY_CLIENT_SECRET=development-only-identity-secret-rotate-me

# --- Application -----------------------------------------------------------
APP_BASE_URL=http://localhost:8080

# Keycloak is reached at this address by the browser and by the services alike.
# That requires one line in /etc/hosts: 127.0.0.1 keycloak
OIDC_ISSUER=http://keycloak:8180/realms/hwms

# Set only where the browser-facing issuer and the internally reachable address
# genuinely differ, as they do behind an ingress. Leave unset on Compose.
# OIDC_DISCOVERY_URL=

# False locally because there is no TLS. True everywhere else — the session
# cookie carries access to health data.
COOKIE_SECURE=false

# Infirmary workstations are shared space, so inactivity ends the session.
SESSION_IDLE_TIMEOUT=30m

LOG_LEVEL=info

# --- Observability ---------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin-development-password
